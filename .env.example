# Copy this file to .env and replace the placeholder. Never commit .env.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional V0 settings
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=2

# Optional V2 knowledge-database settings for local development only.
# These demo credentials are not production-safe.
KNOWLEDGE_DATABASE_URL=postgresql+psycopg://knowledge_app:knowledge_app_local_only@127.0.0.1:5433/knowledge_agent
KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-2
KNOWLEDGE_EMBEDDING_DIMENSION=768
