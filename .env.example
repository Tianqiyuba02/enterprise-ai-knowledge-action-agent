# Copy this file to .env and replace the placeholder. Never commit .env.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional V0 settings
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=2

# Optional V2 knowledge-database settings for local development only.
# These demo credentials are not production-safe.
KNOWLEDGE_DATABASE_URL=postgresql+psycopg://knowledge_app:knowledge_app_local_only@127.0.0.1:5433/knowledge_agent
KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-2
KNOWLEDGE_EMBEDDING_DIMENSION=768
KNOWLEDGE_GROUNDED_MODEL=gemini-3.6-flash

# Optional V3 agent settings.
AGENT_MODEL=gemini-3.6-flash
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_ATTEMPTS=1

# Optional V4 demo TTLs.
V4_CONFIRMATION_CHALLENGE_TTL_SECONDS=600
V4_CONFIRMED_TTL_SECONDS=600
V4_ACTION_TTL_SECONDS=1800

# Optional V5 M3 public-demo controls. Keep disabled for ordinary local development.
# INTERNAL_PORTAL_KEY must be at least 24 random characters when public-demo mode is enabled.
PUBLIC_DEMO_MODE=false
INTERNAL_PORTAL_KEY=replace-with-a-long-random-server-only-key
APP_DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DEMO_VISITOR_ASSISTANT_DAILY_LIMIT=8
DEMO_VISITOR_ACTION_DAILY_LIMIT=4
DEMO_VISITOR_REVISION_DAILY_LIMIT=8
DEMO_GLOBAL_ASSISTANT_DAILY_LIMIT=60
DEMO_GLOBAL_EXECUTION_DAILY_LIMIT=40
DEMO_GLOBAL_PROVIDER_DAILY_LIMIT=300
DEMO_EXPECTED_DOCUMENT_COUNT=13
DEMO_EXPECTED_CHUNK_COUNT=47
DEMO_WORKER_STALE_SECONDS=20
DEMO_ASSISTANT_DEADLINE_SECONDS=45
